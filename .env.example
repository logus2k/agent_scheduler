# Agent Scheduler — configuration (copy to .env; all values have safe defaults in config.py)

# --- Valkey connection (shared valkey-bus) ---
# Inside the compose network the host is the service name; from the host it is 127.0.0.1.
VALKEY_HOST=valkey-bus
VALKEY_PORT=6379

# --- Stream / discovery conventions (MUST match agent_bus) ---
STREAM_PREFIX=stream:
ACTIVE_STREAMS_KEY=streams:active

# --- RedisJobStore keys (namespaced; do not collide with agent_bus keys) ---
JOBS_KEY=agent_scheduler.jobs
RUN_TIMES_KEY=agent_scheduler.run_times

# --- Emission identity ---
SENDER_ID=agent_scheduler
DEFAULT_EVENT_TYPE=schedule.fired

# --- Misfire policy (behavior around downtime) ---
# Fires missed by more than this many seconds are skipped, not run late.
MISFIRE_GRACE_TIME=30
# Collapse multiple missed fires of one job into a single catch-up run.
COALESCE=true

# --- Publisher connection retry (startup resilience across compose projects) ---
CONNECT_RETRIES=30
CONNECT_RETRY_DELAY_S=2

# --- Resource retention (bound the keys/streams the emitter creates) ---
# TTL (seconds) on the per-fire sid:<cid> key (match agent_bus STREAM_TTL_S).
SID_TTL_S=3600
# Approximate MAXLEN per scheduler stream (XADD MAXLEN ~ N). 0 = unbounded.
STREAM_MAXLEN=10000
# Also delete a derived per-job stream key when its job is deleted (default false).
STREAM_DELETE_ON_JOB_DELETE=false

# --- Bus ingress: the schedule.requested consumer ("Scheduler-bridge") ---
# When on, a consumer-group tails the control stream and registers a
# Schedule+Binding from each schedule.requested event (agents self-schedule over
# the bus). Idempotent upsert by schedule_id. Needs the embedded scheduler to fire.
INGRESS_ENABLED=true
# Bare id of the control stream (full key stream:<id>); distinct from any target.
INGRESS_STREAM_ID=schedule-requests
INGRESS_GROUP=cg:agent_scheduler
INGRESS_CONSUMER_NAME=agent_scheduler-ingress
# The event_type acted on; any other type on the stream is acked+ignored.
REQUEST_EVENT_TYPE=schedule.requested
# XREADGROUP block/count per poll.
INGRESS_BLOCK_MS=5000
INGRESS_COUNT=32
# Idle threshold (ms) for reclaiming crash-pending requests at startup.
INGRESS_RECLAIM_MIN_IDLE_MS=60000
# Dead-letter stream for unparseable/invalid requests (match agent_bus).
DLQ_STREAM=stream:dlq

# --- Admin API ---
API_HOST=0.0.0.0
API_PORT=6816

# --- Logging ---
LOG_LEVEL=INFO
